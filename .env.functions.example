# Copy to .env.functions.local; deploy with supabase secrets set --env-file.
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.5-flash-lite
# Choose google or groq. Groq uses GPT-OSS 20B first, with reviewed Gemini fallback.
CHAT_PROVIDER=google
# Only required when CHAT_PROVIDER=groq; keep this server-side.
GROQ_API_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=YOUR_PRIVATE_TURNSTILE_SECRET_KEY
# Exact frontend origins, comma-separated, without trailing slashes.
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_PORTFOLIO_DOMAIN
# Generate two separate random secrets: openssl rand -hex 32
RATE_LIMIT_SALT=REPLACE_WITH_RANDOM_SECRET
INGEST_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
